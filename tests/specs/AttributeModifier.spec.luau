local TestKit = require("../harness/TestKit")
local describe, it, sandbox, eq, ok = TestKit.describe, TestKit.it, TestKit.sandbox, TestKit.eq, TestKit.ok

describe("AttributeModifier on properties", function()
	it("increments and undoes a property", function()
		local sb = sandbox()
		local humanoid = sb.new("Humanoid")
		local modifier = sb.require("AttributeModifier").new(humanoid, "WalkSpeed")

		local undo = modifier:IncrementValue(10)
		eq(humanoid.WalkSpeed, 26)
		undo.Undo()
		eq(humanoid.WalkSpeed, 16)
	end)

	it("sets and undoes a property, including out of order stacking", function()
		local sb = sandbox()
		local humanoid = sb.new("Humanoid")
		local modifier = sb.require("AttributeModifier").new(humanoid, "WalkSpeed")

		local undo1 = modifier:SetValue(50)
		local undo2 = modifier:SetValue(100)
		eq(humanoid.WalkSpeed, 100)
		undo2.Undo()
		eq(humanoid.WalkSpeed, 50)
		undo1.Undo()
		eq(humanoid.WalkSpeed, 16)
	end)

	it("keeps the stacked value when the engine clamps a property", function()
		local sb = sandbox()
		local humanoid = sb.new("Humanoid")
		local modifier = sb.require("AttributeModifier").new(humanoid, "WalkSpeed")

		local slow = modifier:IncrementValue(-20)
		eq(humanoid.WalkSpeed, 0)
		local boost = modifier:IncrementValue(10)
		eq(humanoid.WalkSpeed, 6)
		boost.Undo()
		eq(humanoid.WalkSpeed, 0)
		slow.Undo()
		eq(humanoid.WalkSpeed, 16)
	end)

	it("does not overwrite a value another system wrote in between", function()
		local sb = sandbox()
		local humanoid = sb.new("Humanoid")
		local modifier = sb.require("AttributeModifier").new(humanoid, "WalkSpeed")

		humanoid.WalkSpeed = 30
		modifier:IncrementValue(5)
		eq(humanoid.WalkSpeed, 35)
	end)

	it("supports Instance-valued properties", function()
		local sb = sandbox()
		local model = sb.new("Model")
		local part = sb.new("Part", { Parent = model })
		local modifier = sb.require("AttributeModifier").new(model, "PrimaryPart")

		local undo = modifier:SetValue(part)
		eq(model.PrimaryPart, part)
		undo.Undo()
		eq(model.PrimaryPart, nil)
	end)
end)

describe("AttributeModifier on attributes", function()
	it("works with a real attribute as documented", function()
		local sb = sandbox()
		local part = sb.new("Part")
		part:SetAttribute("CustomValue", 10)
		local modifier = sb.require("AttributeModifier").new(part, "CustomValue")

		local undo1 = modifier:SetValue(50)
		eq(part:GetAttribute("CustomValue"), 50)
		local undo2 = modifier:SetValue(100)
		eq(part:GetAttribute("CustomValue"), 100)
		undo2.Undo()
		eq(part:GetAttribute("CustomValue"), 50)
		undo1.Undo()
		eq(part:GetAttribute("CustomValue"), 10)
	end)

	it("treats a missing attribute as 0 when incrementing", function()
		local sb = sandbox()
		local part = sb.new("Part")
		local modifier = sb.require("AttributeModifier").new(part, "Stacks")

		local undo = modifier:IncrementValue(2)
		eq(part:GetAttribute("Stacks"), 2)
		undo.Undo()
		eq(part:GetAttribute("Stacks"), 0)
	end)

	it("uses the attribute when a child shares the name", function()
		local sb = sandbox()
		local model = sb.new("Model")
		sb.new("Folder", { Name = "Health", Parent = model })
		model:SetAttribute("Health", 100)
		local modifier = sb.require("AttributeModifier").new(model, "Health")

		modifier:IncrementValue(-25)
		eq(model:GetAttribute("Health"), 75)
	end)

	it("uses the attribute when the name collides with a method or event", function()
		local sb = sandbox()
		local part = sb.new("Part")
		part:SetAttribute("Destroying", 1)
		local modifier = sb.require("AttributeModifier").new(part, "Destroying")
		modifier:SetValue(2)
		eq(part:GetAttribute("Destroying"), 2)
	end)
end)

describe("AttributeModifier lifecycle", function()
	it("returns the same modifier for the same instance and name", function()
		local sb = sandbox()
		local AttributeModifier = sb.require("AttributeModifier")
		local humanoid = sb.new("Humanoid")
		eq(AttributeModifier.new(humanoid, "WalkSpeed"), AttributeModifier.new(humanoid, "WalkSpeed"))
		ok(AttributeModifier.new(humanoid, "WalkSpeed") ~= AttributeModifier.new(humanoid, "Health"))
	end)

	it("Undo only reverts once", function()
		local sb = sandbox()
		local humanoid = sb.new("Humanoid")
		local modifier = sb.require("AttributeModifier").new(humanoid, "WalkSpeed")

		local undo = modifier:IncrementValue(4)
		undo.Undo()
		undo.Undo()
		eq(humanoid.WalkSpeed, 16)

		local setUndo = modifier:SetValue(30)
		setUndo.Undo()
		modifier:SetValue(40)
		setUndo.Undo()
		eq(humanoid.WalkSpeed, 40)
	end)

	it("returns a harmless undo after being destroyed", function()
		local sb = sandbox()
		local humanoid = sb.new("Humanoid")
		local modifier = sb.require("AttributeModifier").new(humanoid, "WalkSpeed")
		local earlierUndo = modifier:IncrementValue(1)
		modifier:Destroy()
		modifier:Destroy()

		modifier:IncrementValue(5).Undo()
		modifier:SetValue(5).Undo()
		earlierUndo.Undo()
		eq(humanoid.WalkSpeed, 17)
	end)

	it("destroys itself with the instance and forgets the cache entry", function()
		local sb = sandbox()
		local AttributeModifier = sb.require("AttributeModifier")
		local humanoid = sb.new("Humanoid", { Parent = sb.workspace })
		local modifier = AttributeModifier.new(humanoid, "WalkSpeed")

		humanoid:Destroy()
		eq(modifier._destroyed, true)

		local recreated = sb.new("Humanoid", { Parent = sb.workspace })
		ok(AttributeModifier.new(recreated, "WalkSpeed") ~= modifier)
	end)

	it("cleans up from Destroying alone, in case ancestry events never arrive", function()
		local sb = sandbox()
		local humanoid = sb.new("Humanoid", { Parent = sb.workspace })
		local modifier = sb.require("AttributeModifier").new(humanoid, "WalkSpeed")

		humanoid.Destroying:_fire()
		eq(modifier._destroyed, true)
	end)

	it("rejects a missing instance with a clear error", function()
		local sb = sandbox()
		TestKit.throws(function()
			sb.require("AttributeModifier").new(nil, "WalkSpeed")
		end, "AttributeModifier.new")
	end)
end)

local TestKit = require("../harness/TestKit")
local describe, it, sandbox, eq, ok, no = TestKit.describe, TestKit.it, TestKit.sandbox, TestKit.eq, TestKit.ok, TestKit.no

local function startWaiting(sb, ...)
	local waitForChild = sb.require("waitForChild")
	local outcome = { finished = false }
	local args = table.pack(...)
	sb.spawn(function()
		outcome.value = waitForChild(table.unpack(args, 1, args.n))
		outcome.finished = true
	end)
	return outcome
end

describe("waitForChild", function()
	it("returns an existing child without yielding", function()
		local sb = sandbox()
		local parent = sb.new("Folder", { Parent = sb.workspace })
		local child = sb.new("Part", { Name = "Target", Parent = parent })
		local outcome = startWaiting(sb, parent, "Target")
		eq(outcome.finished, true)
		eq(outcome.value, child)
	end)

	it("resumes once the child appears", function()
		local sb = sandbox()
		local parent = sb.new("Folder", { Parent = sb.workspace })
		local outcome = startWaiting(sb, parent, "Target")
		sb.step()
		eq(outcome.finished, false)

		local child = sb.new("Part", { Name = "Target", Parent = parent })
		sb.step()
		eq(outcome.finished, true)
		eq(outcome.value, child)
	end)

	it("finds a child that was renamed after being parented", function()
		local sb = sandbox()
		local parent = sb.new("Folder", { Parent = sb.workspace })
		local outcome = startWaiting(sb, parent, "Target")

		local child = sb.new("Part", { Parent = parent })
		sb.step()
		child.Name = "Target"
		sb.step()
		eq(outcome.value, child)
	end)

	it("returns nil and warns on timeout", function()
		local sb = sandbox()
		local parent = sb.new("Folder", { Parent = sb.workspace })
		local outcome = startWaiting(sb, parent, "Target", 1)
		sb.advance(0.5)
		eq(outcome.finished, false)
		sb.advance(0.6)
		eq(outcome.finished, true)
		eq(outcome.value, nil)
		ok(sb.hasWarning("Timed out"))
	end)

	it("returns nil when the parent is destroyed, without a timeout warning", function()
		local sb = sandbox()
		local parent = sb.new("Folder", { Parent = sb.workspace })
		local outcome = startWaiting(sb, parent, "Target")
		parent:Destroy()
		sb.step()
		eq(outcome.finished, true)
		eq(outcome.value, nil)
		no(sb.hasWarning("Timed out"))
	end)

	it("warns once about a possible infinite yield", function()
		local sb = sandbox()
		local parent = sb.new("Folder", { Parent = sb.workspace })
		local outcome = startWaiting(sb, parent, "Target")
		sb.advance(31)
		sb.advance(31)
		eq(outcome.finished, false)
		eq(#sb.warnings, 1)
		ok(sb.hasWarning("Infinite yield possible"))
	end)

	it("can wait on game, which has no Parent but is never destroyed", function()
		local sb = sandbox()
		local outcome = startWaiting(sb, sb.game, "LateService")
		sb.step()
		eq(outcome.finished, false)

		local late = sb.new("Folder", { Name = "LateService", Parent = sb.game })
		sb.step()
		eq(outcome.value, late)
	end)

	it("returns a child that arrives in the same frame the parent loses its Parent", function()
		local sb = sandbox()
		local parent = sb.new("Folder", { Parent = sb.workspace })
		local outcome = startWaiting(sb, parent, "Target")
		local child = sb.new("Part", { Name = "Target", Parent = parent })
		parent.Parent = nil
		sb.step()
		eq(outcome.value, child)
	end)
end)
